# Placeholder host only. The organization implementing EarthID Enterprise provides the exact Issuer URL (which may include a path).
EARTHID_ISSUER=https://earthid.organization-domain.com

# Every client and callback URI must be approved. These are placeholders.
EARTHID_CLIENT_ID=replace-with-approved-client-id
EARTHID_CLIENT_SECRET=replace-with-private-client-secret
EARTHID_REDIRECT_URI=http://localhost:8080/callback
