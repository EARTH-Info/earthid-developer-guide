# Confirm exact issuer and availability with the deployment administrator.
EARTHID_ISSUER=https://idp.dbkk.my/api/earthid

# Approved confidential OIDC client credentials (never commit real values).
EARTHID_CLIENT_ID=replace-with-approved-client-id
EARTHID_CLIENT_SECRET=replace-with-private-client-secret

# This URL must match the environment actually serving the app.
NEXTAUTH_URL=http://localhost:3000

# Generate using: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret
